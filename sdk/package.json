{
  "name": "@frame/sdk",
  "version": "0.2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lifetime": {
      "types": "./dist/lifetime.d.ts",
      "import": "./dist/lifetime.js"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js"
    },
    "./protocol": {
      "types": "./dist/protocol.generated.d.ts",
      "import": "./dist/protocol.generated.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "src/*/README.md"
  ],
  "scripts": {
    "build": "node ../scripts/build-node.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  },
  "optionalDependencies": {
    "@types/node": "^26.6.5",
    "decimal.js": "10.6.0",
    "jsonschema": "1.5.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
