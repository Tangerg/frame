{
  "name": "@frame/sdk",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lifetime": {
      "types": "./dist/lifetime.d.ts",
      "import": "./dist/lifetime.js"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js"
    },
    "./protocol": {
      "types": "./dist/protocol.generated.d.ts",
      "import": "./dist/protocol.generated.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  }
}
